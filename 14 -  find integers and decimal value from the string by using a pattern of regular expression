import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class RegexNumber {

    public static void main(String[] args) {

        // Input string with numbers
        String text = "The prices are 50, 99.99, and 1000 along with 45.5 and 200.";

 // Regular expression pattern to match integers and decimal numbers
        Pattern pattern = Pattern.compile("\\d+\\.\\d+|\\d+");
        Matcher matcher = pattern.matcher(text);

        System.out.println("Numbers found in the string:");

        // Find and print all matches
        while (matcher.find()) {
            System.out.println(matcher.group());
        }
    }
}
