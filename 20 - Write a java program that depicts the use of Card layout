import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class CardLayoutExample extends JFrame implements ActionListener {

    CardLayout card;
    JPanel cardPanel;
    JButton nextBtn, prevBtn;

    CardLayoutExample() {

        setTitle("CardLayout Example");
        setSize(500, 300);
        setLayout(new BorderLayout());

        // CardLayout
        card = new CardLayout(20, 20);
        cardPanel = new JPanel(card);

        // ----------- Cards with required values -----------

        JPanel card1 = new JPanel();
        card1.add(new JLabel("PARUL University"));

        JPanel card2 = new JPanel();
        card2.add(new JLabel("FITCS"));

        JPanel card3 = new JPanel();
        card3.add(new JLabel("MCA / MScIT"));

        // Add cards
        cardPanel.add(card1, "PARUL");
        cardPanel.add(card2, "FITCS");
        cardPanel.add(card3, "MCA");

        // ----------- Control Buttons -----------

        JPanel buttonPanel = new JPanel();
        prevBtn = new JButton("Previous");
        nextBtn = new JButton("Next");

        buttonPanel.add(prevBtn);
        buttonPanel.add(nextBtn);

        prevBtn.addActionListener(this);
        nextBtn.addActionListener(this);

        // Add to frame
        add(cardPanel, BorderLayout.CENTER);
        add(buttonPanel, BorderLayout.SOUTH);

        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setVisible(true);
    }

    // Button actions
    public void actionPerformed(ActionEvent e) {

        if (e.getSource() == nextBtn) {
            card.next(cardPanel);
        }

        if (e.getSource() == prevBtn) {
            card.previous(cardPanel);
        }
    }

    public static void main(String[] args) {
        new CardLayoutExample();
    }
}
